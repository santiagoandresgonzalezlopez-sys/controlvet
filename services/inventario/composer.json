{
    "name": "controlvet/inventario-service",
    "description": "Microservicio de inventario de productos de ControlVet.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "controlvet/kernel": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        { "type": "path", "url": "../../libs/kernel", "options": { "symlink": false } }
    ],
    "autoload": {
        "psr-4": {
            "ControlVet\\Inventario\\Controller\\": "controller/",
            "ControlVet\\Inventario\\Validador\\": "validador/",
            "ControlVet\\Inventario\\Microservicio\\": "microservicio/"
        }
    },
    "autoload-dev": {
        "psr-4": { "ControlVet\\Inventario\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.2.12" },
        "sort-packages": true
    }
}
