# =====================================================================
# Plantilla de variables de entorno de ControlVet.
# Copie a .env y reemplace TODOS los valores. .env NO se versiona.
# Ansible genera este archivo automáticamente con secretos aleatorios
# (infra/ansible/playbooks/site.yml); úsela solo para pruebas manuales.
# =====================================================================

# Identificación del despliegue
CV_PROJECT=controlvet
CV_VERSION=dev
CV_REGISTRY=localhost:5000
APP_ENV=dev            # dev muestra las credenciales demo en el login; usar prod fuera de local
WEB_PORT=8090

# Seguridad (mínimo 32 caracteres aleatorios)
JWT_SECRET=CAMBIAR-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# Base de datos: contraseña de root y una por microservicio
DB_ROOT_PASSWORD=CAMBIAR
AUTH_DB_PASSWORD=CAMBIAR
PACIENTES_DB_PASSWORD=CAMBIAR
CITAS_DB_PASSWORD=CAMBIAR
CLINICA_DB_PASSWORD=CAMBIAR
INVENTARIO_DB_PASSWORD=CAMBIAR
DOCUMENTOS_DB_PASSWORD=CAMBIAR
MONITOR_DB_PASSWORD=CAMBIAR
