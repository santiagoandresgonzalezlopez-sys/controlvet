###############################################################################
# ControlVet · hosts y servicios supervisados (entorno de PRODUCCIÓN: /{{ ruta }})
# Generado por Ansible (playbooks/monitoreo.yml). No editar a mano.
#
# Sin contenedores, los 6 microservicios son endpoints del Apache de XAMPP;
# cada uno se supervisa como un servicio de Nagios independiente.
# Umbrales: 1 comprobación por minuto; estado HARD (y alerta) tras 2 fallos
# consecutivos, es decir, un fallo se notifica en 1-2 minutos.
###############################################################################

define host {
    name                    controlvet-host
    use                     generic-host
    check_interval          1
    retry_interval          1
    max_check_attempts      2
    notification_interval   0
    notification_period     24x7
    notification_options    d,u,r
    contact_groups          controlvet-ops
    register                0
}

define service {
    name                    controlvet-service
    use                     generic-service
    check_interval          1
    retry_interval          1
    max_check_attempts      2
    notification_interval   0
    notification_options    w,u,c,r
    contact_groups          controlvet-ops
    register                0
}

# Apache de XAMPP en Windows (aloja frontend y microservicios).
define host {
    use             controlvet-host
    host_name       xampp-apache
    alias           Apache de XAMPP (Windows) - frontend y microservicios
    address         {{ windows_ip }}
    check_command   check_cv_tcp!80
}

# Instancia MariaDB dedicada de ControlVet (127.0.0.1:{{ db_puerto }} en Windows).
define host {
    use             controlvet-host
    host_name       mariadb-controlvet
    alias           MariaDB de ControlVet (un esquema y usuario por servicio)
    address         127.0.0.1
    check_command   check_cv_mysql
}

define hostgroup {
    hostgroup_name  controlvet
    alias           ControlVet
    members         xampp-apache,mariadb-controlvet
}

{% for s in servicios %}
define service {
    use                     controlvet-service
    host_name               xampp-apache
    service_description     API {{ s }}
    check_command           check_cv_health!/{{ ruta }}/api/{{ s }}/health!1!3
}

{% endfor %}
define service {
    use                     controlvet-service
    host_name               xampp-apache
    service_description     Login web
    check_command           check_cv_pagina!/{{ ruta }}/web/index.php?route=login!ControlVet
}

define service {
    use                     controlvet-service
    host_name               xampp-apache
    service_description     Dependencias del frontend
    check_command           check_cv_health!/{{ ruta }}/web/health.php!2!5
}

define service {
    use                     controlvet-service
    host_name               mariadb-controlvet
    service_description     MariaDB conexion
    check_command           check_cv_mysql
}
