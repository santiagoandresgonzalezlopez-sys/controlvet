# Generado por Ansible ({{ ansible_date_time.iso8601 }}). NO editar a mano ni versionar.
# Los secretos se crean una sola vez y se conservan en {{ cv_ops_dir }}/secrets.
CV_PROJECT={{ cv_project }}
CV_VERSION={{ cv_version_env }}
CV_REGISTRY={{ cv_registry }}
APP_ENV={{ cv_app_env }}
WEB_PORT={{ cv_web_port }}
JWT_SECRET={{ lookup('ansible.builtin.password', cv_ops_dir ~ '/secrets/jwt_secret', length=48, chars=['ascii_letters', 'digits']) }}
DB_ROOT_PASSWORD={{ lookup('ansible.builtin.password', cv_ops_dir ~ '/secrets/db_root', length=28, chars=['ascii_letters', 'digits']) }}
{% for s in cv_servicios + ['monitor'] %}
{{ s | upper }}_DB_PASSWORD={{ lookup('ansible.builtin.password', cv_ops_dir ~ '/secrets/db_' ~ s, length=28, chars=['ascii_letters', 'digits']) }}
{% endfor %}
