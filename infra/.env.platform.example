# Copie a infra/.env.platform (no versionado) y defina contraseñas propias.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=CAMBIAR
NAGIOS_ADMIN_USER=nagiosadmin
